import Lemmatheca.EhrenfeuchtMostowskiModels.Templates

/-! Generated hulls and the specified maps induced by increasing skeleton maps. -/
namespace Lemmatheca.ModelTheory.EhrenfeuchtMostowski
open FirstOrder FirstOrder.Language Cardinal
universe u v w w' w'' z z' z''
variable (K : Language.{u,v}) {I : Type z} {J : Type z'} {Q : Type z''}
variable {N : Type w} {P : Type w'} {R : Type w''}
variable [K.Structure N] [K.Structure P] [K.Structure R]

/-- The expanded EM hull is the actual substructure generated by the skeleton. -/
def hull (b : I → N) : K.Substructure N :=
  Substructure.closure K (Set.range b)

def hullGenerator (b : I → N) (i : I) : hull K b :=
  ⟨b i, Substructure.subset_closure ⟨i,rfl⟩⟩

def termValue (b : I → N) {r : ℕ} (t : K.Term (Fin r)) (indices : Fin r → I) :
    hull K b :=
  ⟨t.realize (b ∘ indices), t.realize_mem _ (fun i =>
    Substructure.subset_closure ⟨indices i,rfl⟩)⟩

theorem hull_finite_presentation (b : I → N) (a : hull K b) :
    ∃ r, ∃ t : K.Term (Fin r), ∃ indices : Fin r → I,
      termValue K b t indices = a := by
  classical
  obtain ⟨r,vals,t,ha,ht⟩ :=
    (ElementarySubmodels.mem_generated_iff_finite_term (Set.range b) a.val).mp a.property
  choose indices hi using ha
  refine ⟨r,t,indices,Subtype.ext ?_⟩
  change t.realize (b ∘ indices) = a.val
  have he : b ∘ indices = vals := funext hi
  rw [he,ht]

def TermRule [LinearOrder I] [LinearOrder J] (b : I → N) (c : J → P)
    (f : I ↪o J) (g : hull K b → hull K c) : Prop :=
  ∀ r (t : K.Term (Fin r)) (indices : Fin r → I),
    g (termValue K b t indices) = termValue K c t (f ∘ indices)

variable {K} (T : K.Theory) (p : Template.{u,v,w''} T)
variable [LinearOrder I] [LinearOrder J] [LinearOrder Q]

private theorem template_arbitrary_formula (b : I → N) (c : J → P)
    (hb : RealizesTemplate T p b) (hc : RealizesTemplate T p c) (f : I ↪o J)
    (φ : K.Formula I) : φ.Realize b ↔ φ.Realize (c ∘ f) := by
  classical
  let S := φ.freeVarFinset
  let e : Fin S.card ≃o S := S.orderIsoOfFin rfl
  let eI : Fin S.card ↪o I := e.toOrderEmbedding.trans (OrderEmbedding.subtype _)
  let ψ : K.Formula (Fin S.card) := φ.restrictFreeVar e.symm
  have h := (hb S.card eI ψ).trans ((hc S.card (eI.trans f) ψ).symm)
  have hleft : ψ.Realize (b ∘ eI) ↔ φ.Realize b := by
    exact BoundedFormula.realize_restrictFreeVar b (fun a => by
      change b (e (e.symm a)).val = b a.val
      rw [e.apply_symm_apply])
  have hright : ψ.Realize (c ∘ (eI.trans f)) ↔ φ.Realize (c ∘ f) := by
    exact BoundedFormula.realize_restrictFreeVar (c ∘ f) (fun a => by
      change c (f (e (e.symm a)).val) = c (f a.val)
      rw [e.apply_symm_apply])
  exact hleft.symm.trans (h.trans hright)

theorem term_equality_iff (b : I → N) (c : J → P)
    (hb : RealizesTemplate T p b) (hc : RealizesTemplate T p c) (f : I ↪o J)
    {r s : ℕ} (t : K.Term (Fin r)) (t' : K.Term (Fin s))
    (indices : Fin r → I) (indices' : Fin s → I) :
    termValue K b t indices = termValue K b t' indices' ↔
      termValue K c t (f ∘ indices) = termValue K c t' (f ∘ indices') := by
  have h := template_arbitrary_formula T p b c hb hc f
    ((t.relabel indices).equal (t'.relabel indices'))
  simpa only [Formula.realize_equal,Term.realize_relabel,termValue,Subtype.mk.injEq,
    Function.comp_assoc] using h

theorem unique_injective_term_map (b : I → N) (c : J → P)
    (hb : RealizesTemplate T p b) (hc : RealizesTemplate T p c) (f : I ↪o J) :
    ∃! g : hull K b → hull K c, TermRule K b c f g ∧ Function.Injective g := by
  classical
  choose r t ix ht using hull_finite_presentation K b
  let g : hull K b → hull K c := fun a => termValue K c (t a) (f ∘ ix a)
  have hr : TermRule K b c f g := by
    intro n q js
    let a := termValue K b q js
    change termValue K c (t a) (f ∘ ix a) = termValue K c q (f ∘ js)
    exact (term_equality_iff T p b c hb hc f (t a) q (ix a) js).mp (ht a)
  have hg : Function.Injective g := by
    intro a a' he
    have h := (term_equality_iff T p b c hb hc f (t a) (t a') (ix a) (ix a')).mpr he
    simpa only [ht] using h
  refine ⟨g,⟨hr,hg⟩,?_⟩
  intro g' hg'
  funext a
  rw [← ht a,hg'.1,hr]

noncomputable def termMap (b : I → N) (c : J → P)
    (hb : RealizesTemplate T p b) (hc : RealizesTemplate T p c) (f : I ↪o J) :
    hull K b → hull K c :=
  (unique_injective_term_map T p b c hb hc f).choose

theorem termMap_rule (b : I → N) (c : J → P)
    (hb : RealizesTemplate T p b) (hc : RealizesTemplate T p c) (f : I ↪o J) :
    TermRule K b c f (termMap T p b c hb hc f) := by
  exact (unique_injective_term_map T p b c hb hc f).choose_spec.1.1

theorem termMap_injective (b : I → N) (c : J → P)
    (hb : RealizesTemplate T p b) (hc : RealizesTemplate T p c) (f : I ↪o J) :
    Function.Injective (termMap T p b c hb hc f) := by
  exact (unique_injective_term_map T p b c hb hc f).choose_spec.1.2

theorem termMap_generator (b : I → N) (c : J → P)
    (hb : RealizesTemplate T p b) (hc : RealizesTemplate T p c) (f : I ↪o J) (i : I) :
    termMap T p b c hb hc f (hullGenerator K b i) = hullGenerator K c (f i) := by
  exact termMap_rule T p b c hb hc f 1 (Term.var 0) (fun _ => i)

/-- Formula agreement concerns this particular term map, not an unrelated embedding. -/
theorem termMap_formula (b : I → N) (c : J → P)
    (hb : RealizesTemplate T p b) (hc : RealizesTemplate T p c) (f : I ↪o J)
    (he : (hull K b).IsElementary) (he' : (hull K c).IsElementary)
    {r : ℕ} (φ : K.Formula (Fin r)) (a : Fin r → hull K b) :
    φ.Realize (termMap T p b c hb hc f ∘ a) ↔ φ.Realize a := by
  classical
  choose n ts ix ht using fun i => hull_finite_presentation K b (a i)
  let q : Fin r → K.Term I := fun i => (ts i).relabel (ix i)
  let ψ : K.Formula I := φ.subst q
  have h := template_arbitrary_formula T p b c hb hc f ψ
  have hleft : ψ.Realize b ↔ φ.Realize (Subtype.val ∘ a) := by
    change BoundedFormula.Realize (φ.subst q) b default ↔ _
    rw [BoundedFormula.realize_subst]
    change Formula.Realize φ (fun i => (q i).realize b) ↔ _
    have hv : (fun i => (q i).realize b) = Subtype.val ∘ a := by
      funext i
      simpa only [q,Term.realize_relabel,termValue,Function.comp_apply] using congrArg Subtype.val (ht i)
    rw [hv]
  have hright : ψ.Realize (c ∘ f) ↔
      φ.Realize (Subtype.val ∘ termMap T p b c hb hc f ∘ a) := by
    change BoundedFormula.Realize (φ.subst q) (c ∘ f) default ↔ _
    rw [BoundedFormula.realize_subst]
    change Formula.Realize φ (fun i => (q i).realize (c ∘ f)) ↔ _
    have hv : (fun i => (q i).realize (c ∘ f)) =
        Subtype.val ∘ termMap T p b c hb hc f ∘ a := by
      funext i
      have hi := termMap_rule T p b c hb hc f (n i) (ts i) (ix i)
      rw [ht i] at hi
      simpa only [q,Term.realize_relabel,termValue,Function.comp_assoc,Function.comp_apply] using (congrArg Subtype.val hi).symm
    rw [hv]
  exact (he' φ (termMap T p b c hb hc f ∘ a)).symm.trans
    (hright.symm.trans (h.symm.trans (hleft.trans (he φ a))))

theorem termMap_id (b : I → N) (hb : RealizesTemplate T p b) :
    termMap T p b b hb hb (OrderIso.refl I).toOrderEmbedding = id := by
  funext a
  obtain ⟨r,t,ix,rfl⟩ := hull_finite_presentation K b a
  rw [termMap_rule]
  rfl

theorem termMap_comp (b : I → N) (c : J → P) (d : Q → R)
    (hb : RealizesTemplate T p b) (hc : RealizesTemplate T p c)
    (hd : RealizesTemplate T p d) (f : I ↪o J) (g : J ↪o Q) :
    termMap T p b d hb hd (f.trans g) =
      termMap T p c d hc hd g ∘ termMap T p b c hb hc f := by
  funext a
  obtain ⟨r,t,ix,rfl⟩ := hull_finite_presentation K b a
  change termMap T p b d hb hd (f.trans g) (termValue K b t ix) =
    termMap T p c d hc hd g (termMap T p b c hb hc f (termValue K b t ix))
  rw [termMap_rule,termMap_rule,termMap_rule]
  rfl

theorem termMap_inverse (b : I → N) (hb : RealizesTemplate T p b) (f : I ≃o I) :
    Function.LeftInverse (termMap T p b b hb hb f.symm.toOrderEmbedding)
      (termMap T p b b hb hb f.toOrderEmbedding) ∧
    Function.RightInverse (termMap T p b b hb hb f.symm.toOrderEmbedding)
      (termMap T p b b hb hb f.toOrderEmbedding) := by
  constructor
  · intro a
    obtain ⟨r,t,ix,rfl⟩ := hull_finite_presentation K b a
    rw [termMap_rule,termMap_rule]
    congr 1
    funext i
    exact f.symm_apply_apply (ix i)
  · intro a
    obtain ⟨r,t,ix,rfl⟩ := hull_finite_presentation K b a
    rw [termMap_rule,termMap_rule]
    congr 1
    funext i
    exact f.apply_symm_apply (ix i)

end Lemmatheca.ModelTheory.EhrenfeuchtMostowski

namespace Lemmatheca.ModelTheory.EhrenfeuchtMostowski
open FirstOrder FirstOrder.Language Cardinal
universe u v w w' w'' z z'
variable (L : Language.{u,v}) {M : Type w} [L.Structure M] (m₀ : M)
variable {N : Type w'} {P : Type w''}
variable [(fullySkolemizedLanguage L).Structure N] [Nonempty N]
variable [(fullySkolemizedLanguage L).Structure P] [Nonempty P]

theorem full_hull_elementary [N ⊨ expansionTheory L m₀] (B : Set N) (hB : B.Nonempty) :
    (Substructure.closure (fullySkolemizedLanguage L) B).IsElementary := by
  obtain ⟨_point⟩ := (inferInstance : Nonempty N)
  obtain ⟨_generator,_membership⟩ := hB
  apply Substructure.isElementary_of_exists
  intro n φ a y hy
  have hax : N ⊨ witnessAxiom (normalizedLanguage L) φ :=
    Theory.realize_sentence_of_mem (expansionTheory L m₀) (witness_mem_expansionTheory L m₀ φ)
  have hEmpty : (Empty.elim : Empty → N) = default := Subsingleton.elim _ _
  have hw := (witnessAxiom_realize (normalizedLanguage L) φ).mp hax
    (Subtype.val ∘ a) ⟨y,by simpa only [hEmpty] using hy⟩
  rw [hEmpty] at hw
  let x := Structure.funMap (witnessSymbol (normalizedLanguage L) φ) (Subtype.val ∘ a)
  have hx : x ∈ Substructure.closure (fullySkolemizedLanguage L) B :=
    (Substructure.closure (fullySkolemizedLanguage L) B).fun_mem _ _ (fun i => (a i).property)
  exact ⟨⟨x,hx⟩,hw⟩

theorem full_hull_models [Nonempty M] (T : L.Theory) [M ⊨ T]
    [N ⊨ expansionTheory L m₀] (B : Set N) (hB : B.Nonempty) :
    let H := Substructure.closure (fullySkolemizedLanguage L) B
    letI : L.Structure H := (originalInclusion L).reduct H
    H ⊨ T := by
  let H := Substructure.closure (fullySkolemizedLanguage L) B
  let E : (fullySkolemizedLanguage L).ElementarySubstructure N :=
    ⟨H,full_hull_elementary L m₀ B hB⟩
  have hN : N ⊨ (originalInclusion L).onTheory T :=
    ⟨fun σ hσ => Theory.realize_sentence_of_mem (expansionTheory L m₀)
      (expansionTheory_contains L m₀ T hσ)⟩
  have hH : H ⊨ (originalInclusion L).onTheory T :=
    (E.subtype.theory_model_iff _).mpr hN
  let : L.Structure H := (originalInclusion L).reduct H
  let : (originalInclusion L).IsExpansionOn H := ⟨fun _ _ => rfl,fun _ _ => rfl⟩
  exact ((originalInclusion L).onTheory_model T).mp hH

theorem full_termMap_formula
    (p : Template.{max u v,max u v,w} (expansionTheory L m₀))
    {I : Type z} {J : Type z'} [LinearOrder I] [LinearOrder J] [Nonempty I] [Nonempty J]
    [N ⊨ expansionTheory L m₀] [P ⊨ expansionTheory L m₀]
    (b : I → N) (c : J → P)
    (hb : RealizesTemplate (expansionTheory L m₀) p b)
    (hc : RealizesTemplate (expansionTheory L m₀) p c) (f : I ↪o J)
    {r : ℕ} (φ : (fullySkolemizedLanguage L).Formula (Fin r))
    (a : Fin r → hull (fullySkolemizedLanguage L) b) :
    φ.Realize (termMap (expansionTheory L m₀) p b c hb hc f ∘ a) ↔ φ.Realize a := by
  exact termMap_formula (expansionTheory L m₀) p b c hb hc f
    (full_hull_elementary L m₀ (Set.range b) (Set.range_nonempty b))
    (full_hull_elementary L m₀ (Set.range c) (Set.range_nonempty c)) φ a

theorem full_termMap_reduct
    (p : Template.{max u v,max u v,w} (expansionTheory L m₀))
    {I : Type z} {J : Type z'} [LinearOrder I] [LinearOrder J] [Nonempty I] [Nonempty J]
    [N ⊨ expansionTheory L m₀] [P ⊨ expansionTheory L m₀]
    (b : I → N) (c : J → P)
    (hb : RealizesTemplate (expansionTheory L m₀) p b)
    (hc : RealizesTemplate (expansionTheory L m₀) p c) (f : I ↪o J) :
    letI : L.Structure (hull (fullySkolemizedLanguage L) b) :=
      (originalInclusion L).reduct _
    letI : L.Structure (hull (fullySkolemizedLanguage L) c) :=
      (originalInclusion L).reduct _
    ∃ e : hull (fullySkolemizedLanguage L) b ↪ₑ[L] hull (fullySkolemizedLanguage L) c,
      ∀ x, e x = termMap (expansionTheory L m₀) p b c hb hc f x := by
  let K := fullySkolemizedLanguage L
  let : L.Structure (hull K b) := (originalInclusion L).reduct _
  let : L.Structure (hull K c) := (originalInclusion L).reduct _
  let : (originalInclusion L).IsExpansionOn (hull K b) := ⟨fun _ _ => rfl,fun _ _ => rfl⟩
  let : (originalInclusion L).IsExpansionOn (hull K c) := ⟨fun _ _ => rfl,fun _ _ => rfl⟩
  refine ⟨⟨termMap (expansionTheory L m₀) p b c hb hc f,?_⟩,fun _ => rfl⟩
  intro r φ a
  exact (LHom.realize_onFormula (M := hull K c) (originalInclusion L) φ).symm.trans
    ((full_termMap_formula L m₀ p b c hb hc f ((originalInclusion L).onFormula φ) a).trans
      (LHom.realize_onFormula (M := hull K b) (originalInclusion L) φ))

theorem full_termMap_automorphism
    (p : Template.{max u v,max u v,w} (expansionTheory L m₀))
    {I : Type z} [LinearOrder I] [Nonempty I] [N ⊨ expansionTheory L m₀]
    (b : I → N) (hb : RealizesTemplate (expansionTheory L m₀) p b) (f : I ≃o I) :
    ∃ e : hull (fullySkolemizedLanguage L) b ≃[fullySkolemizedLanguage L]
      hull (fullySkolemizedLanguage L) b,
      (∀ x, e x = termMap (expansionTheory L m₀) p b b hb hb f.toOrderEmbedding x) ∧
      (∀ x, e.symm x = termMap (expansionTheory L m₀) p b b hb hb f.symm.toOrderEmbedding x) := by
  let g : hull (fullySkolemizedLanguage L) b ↪ₑ[fullySkolemizedLanguage L]
      hull (fullySkolemizedLanguage L) b :=
    ⟨termMap (expansionTheory L m₀) p b b hb hb f.toOrderEmbedding,
      fun {_} φ a => full_termMap_formula L m₀ p b b hb hb f.toOrderEmbedding φ a⟩
  let inv := termMap (expansionTheory L m₀) p b b hb hb f.symm.toOrderEmbedding
  have hi := termMap_inverse (expansionTheory L m₀) p b hb f
  let e : hull (fullySkolemizedLanguage L) b ≃ hull (fullySkolemizedLanguage L) b :=
    ⟨g,inv,hi.1,hi.2⟩
  exact ⟨⟨e,g.map_fun,g.map_rel⟩,fun _ => rfl,fun _ => rfl⟩

theorem full_termMap_reduct_automorphism
    (p : Template.{max u v,max u v,w} (expansionTheory L m₀))
    {I : Type z} [LinearOrder I] [Nonempty I] [N ⊨ expansionTheory L m₀]
    (b : I → N) (hb : RealizesTemplate (expansionTheory L m₀) p b) (f : I ≃o I) :
    letI : L.Structure (hull (fullySkolemizedLanguage L) b) :=
      (originalInclusion L).reduct _
    ∃ e : hull (fullySkolemizedLanguage L) b ≃[L] hull (fullySkolemizedLanguage L) b,
      (∀ x, e x = termMap (expansionTheory L m₀) p b b hb hb f.toOrderEmbedding x) ∧
      (∀ x, e.symm x = termMap (expansionTheory L m₀) p b b hb hb f.symm.toOrderEmbedding x) := by
  let K := fullySkolemizedLanguage L
  let : L.Structure (hull K b) := (originalInclusion L).reduct _
  obtain ⟨e,he,hi⟩ := full_termMap_automorphism L m₀ p b hb f
  let g : hull K b ≃[L] hull K b :=
    { e.toEquiv with
      map_fun' := fun q a => e.map_fun ((originalInclusion L).onFunction q) a
      map_rel' := fun R a => e.map_rel ((originalInclusion L).onRelation R) a }
  exact ⟨g,he,hi⟩

end Lemmatheca.ModelTheory.EhrenfeuchtMostowski

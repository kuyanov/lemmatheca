import Mathlib.ModelTheory.Substructures

/-! Generated function-closed carriers, including empty parameter sets and ground terms. -/

namespace Lemmatheca.ModelTheory.ElementarySubmodels

open FirstOrder FirstOrder.Language

universe u v w
variable {L : Language.{u, v}} {M : Type w} [L.Structure M]

/-- Closure membership has an exact finite-parameter term representation; the context may be empty. -/
theorem mem_generated_iff_finite_term (A : Set M) (b : M) :
    b ∈ Substructure.closure L A ↔
      ∃ (n : ℕ) (a : Fin n → M) (t : L.Term (Fin n)),
        (∀ i, a i ∈ A) ∧ t.realize a = b := by
  classical
  constructor
  · intro hb
    obtain ⟨t, ht⟩ := Substructure.mem_closure_iff_exists_term.mp hb
    let e : t.varFinset ≃ Fin (Fintype.card t.varFinset) := Fintype.equivFin _
    let a : Fin (Fintype.card t.varFinset) → M := fun i => (e.symm i).val.val
    refine ⟨_, a, t.restrictVar e, ?_, ?_⟩
    · intro i
      exact (e.symm i).val.property
    · rw [Term.realize_restrictVar (v' := (Subtype.val : A → M))]
      · exact ht
      · intro i
        exact congrArg (fun j : t.varFinset => j.val.val) (e.symm_apply_apply i)
  · rintro ⟨n, a, t, ha, rfl⟩
    exact t.realize_mem _ fun i => Substructure.subset_closure (ha i)

/-- The carrier generated by no parameters is precisely the set of ground-term values. -/
theorem mem_generated_empty_iff_ground_term (b : M) :
    b ∈ Substructure.closure L (∅ : Set M) ↔
      ∃ t : L.Term (Fin 0), t.realize Fin.elim0 = b := by
  constructor
  · intro hb
    obtain ⟨n, a, t, ha, ht⟩ := mem_generated_iff_finite_term (∅ : Set M) b |>.mp hb
    have hn : n = 0 := by
      by_contra hn
      exact ha ⟨0, Nat.pos_of_ne_zero hn⟩
    subst n
    refine ⟨t, ?_⟩
    simpa only [show a = Fin.elim0 from Subsingleton.elim _ _] using ht
  · rintro ⟨t, rfl⟩
    exact t.realize_mem _ fun i => Fin.elim0 i

/-- Without constants no ground term can be built, so the empty generated carrier is empty. -/
theorem generated_empty_of_no_constants [IsEmpty L.Constants] :
    (Substructure.closure L (∅ : Set M) : Set M) = ∅ := by
  have hground : ∀ t : L.Term (Fin 0), False := by
    intro t
    induction t with
    | var i => exact Fin.elim0 i
    | @func n f ts ih =>
      cases n with
      | zero => exact isEmptyElim f
      | succ n => exact ih 0
  apply Set.eq_empty_iff_forall_notMem.mpr
  intro b hb
  obtain ⟨t, _⟩ := (mem_generated_empty_iff_ground_term b).mp hb
  exact hground t

/-- A constant supplies a point in the carrier generated by the empty set. -/
theorem generated_empty_nonempty_of_constants [Nonempty L.Constants] :
    (Substructure.closure L (∅ : Set M) : Set M).Nonempty := by
  obtain ⟨c⟩ := ‹Nonempty L.Constants›
  refine ⟨Structure.funMap c Fin.elim0, ?_⟩
  exact (Substructure.closure L (∅ : Set M)).fun_mem c Fin.elim0 (fun i => Fin.elim0 i)

/-- A nonempty parameter set has nonempty generated carrier, with no assumption on constants. -/
theorem generated_nonempty_of_nonempty (A : Set M) (hA : A.Nonempty) :
    (Substructure.closure L A : Set M).Nonempty := by
  exact hA.mono Substructure.subset_closure

end Lemmatheca.ModelTheory.ElementarySubmodels

  "signature": "Lemmatheca.Entry.FiniteSequenceCoding.coding_examples :\n  Lemmatheca.ComputabilityTheory.FiniteSequenceCoding.code [0] = 1 ∧\n    Lemmatheca.ComputabilityTheory.FiniteSequenceCoding.code [2] = 7 ∧\n      Lemmatheca.ComputabilityTheory.FiniteSequenceCoding.code [2, 0] = 8 ∧\n        Lemmatheca.ComputabilityTheory.FiniteSequenceCoding.code [2, 0, 0] = 9 ∧\n          Lemmatheca.ComputabilityTheory.FiniteSequenceCoding.decode 8 = [2, 0] ∧\n            Lemmatheca.ComputabilityTheory.FiniteSequenceCoding.length 8 = 2 ∧\n              Lemmatheca.ComputabilityTheory.FiniteSequenceCoding.entry 8 1 = 0 ∧\n                Lemmatheca.ComputabilityTheory.FiniteSequenceCoding.entry 8 2 = 0"
